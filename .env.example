# Base URL of the Hiring-AI backend, including the /api/v1 prefix.
# Defaults to the hosted Render backend if unset.
VITE_API_BASE_URL=https://backend-maj9.onrender.com/api/v1

# Google OAuth 2.0 Web client ID (a PUBLIC value) used by the client-side
# Google Identity Services SDK for the "Continue with Google" button.
#
# The frontend obtains a Google ID token in the browser and exchanges it via
# POST /auth/google — there is no server-side redirect_uri, so nothing needs to
# be configured on the backend for this flow to complete end-to-end.
#
# Create a credential at https://console.cloud.google.com/apis/credentials and
# add every app origin (e.g. http://localhost:3000 and your deployed URL) to the
# "Authorized JavaScript origins" list. Leave blank to disable Google sign-in.
VITE_GOOGLE_CLIENT_ID=
