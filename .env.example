# Base URL of the Hiring-AI backend, including the /api/v1 prefix.
# Defaults to the hosted Render backend if unset.
#
# NOTE: The backend's Google OAuth redirect_uri is currently configured for a
# local backend (http://localhost:3000/api/v1/auth/google/callback), so the
# Google flow only completes end-to-end when pointing at a local backend on
# port 3000. Update the backend's redirect_uri to use the hosted backend in prod.
VITE_API_BASE_URL=https://server-1-919p.onrender.com/api/v1
